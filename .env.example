# API（复制为 apps/api/.env）
DATABASE_URL=postgresql://selfprint:selfprint@127.0.0.1:5432/selfprint
JWT_SECRET=dev-only-change-me
PORT=3000
UPLOAD_DIR=uploads

# 商家后台（复制为 apps/admin/.env.local，可不配，默认即此地址）
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3000/api

# 店内打印代理
API_BASE=http://127.0.0.1:3000/api
AGENT_TOKEN=agt_dev_demo_store_token
PRINT_MODE=mock
PRINTERS=前台打印机
POLL_MS=3000
PRINT_OUT_DIR=printed
